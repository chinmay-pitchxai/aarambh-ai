# GOOGLE AUTH
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# APP
# Required. Generate a unique cryptographically random value of at least 32 characters.
APP_SECRET=

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aarambhai
REDIS_URL=redis://localhost:6379
ALLOW_IN_MEMORY_FALLBACK=true

# LLM
GEMINI_API_KEY=

# Voice (Gemini Live)
VOICE_MODEL=gemini-2.0-flash-live-001
VOICE_NAME=Kore
VOICE_LANGUAGE=en-IN

# Integrations
COMPOSIO_API_KEY=
CALENDAR_PROVIDER=composio
AUTO_ONBOARD_ENABLED=true
FREE_SAMPLE_LEADS=3

# Vobiz (https://console.vobiz.ai — Auth ID + Auth Token; base URL https://api.vobiz.ai)
VOBIZ_API_URL=https://api.vobiz.ai
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
VOBIZ_FROM_NUMBER=
VOBIZ_WEBHOOK_SECRET=

# Webhook secrets (required in production)
WHATSAPP_WEBHOOK_SECRET=
GMAIL_WEBHOOK_SECRET=

# Apollo
APOLLO_API_KEY=

# WhatsApp (legacy direct API)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_ID=

# Gmail (legacy direct API)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Vector DB
QDRANT_URL=http://localhost:6333
SEMANTICA_URL=http://localhost:8000

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
