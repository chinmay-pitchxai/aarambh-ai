  "cards": [
    {
      "dot": "cyan",
      "title": "Mother DB \u2014 Cross-Use",
      "items": [
        "PostgreSQL mother pool, global dedupe phoneE164/email",
        "ICP match \u2192 share lead \u2192 skip Apollo, save \u20b94K-10K/mo",
        "Billing: source_cost + reused_from per row \u2192 client splits",
        "Freshness TTL: Redis 30d, stale \u2192 re-pull from Apollo"
      ]
    },
    {
      "dot": "violet",
      "title": "RLM Memory \u2014 No Restart",
      "items": [
        "Every call transcript \u2192 RLM via Semantica vector + graph",
        "Every WA/Gmail text \u2192 RLM linked to same leadId",
        "Before next turn: recall full history \u2192 personalized greeting",
        "Eviction: 90d text summaries, 365d key events"
      ]
    },
    {
      "dot": "slate",
      "title": "Semantica \u2014 PROV-O Audit",
      "items": [
        "Every interaction = edge + PROV-O provenance + bi-temporal",
        "trace_decision_chain for cross-border compliance audit",
        "state_at() time travel: what consent status at call time",
        "Vector + graph: semantic dedup across client boundaries"
      ]
    },
    {
      "dot": "emerald",
      "title": "Consent Gate (pre-dial)",
      "items": [
        "Ranker checks DNC global + client opt-in before routing to Dialer",
        "Block if no consent \u2192 Park/DNC immediately",
        "Consent status stored in Semantica with timestamp"
      ]
    },
    {
      "dot": "amber",
      "title": "Ops \u2014 Retry + DLQ + Dashboard",
      "items": [
        "Nudge: no answer/failed \u2192 WA \"tried reaching\" \u2192 Retry 24h \u2192 dialer",
        "Nudge: not interested \u2192 Park/DNC/DLQ + ops alert",
        "Booked \u2192 30m reminder call + Dashboard tracks pipeline KPI",
        "Dashboard: Hot/Warm/Cold counts, booking rate, ROAS per client"
      ]
    },
    {
      "dot": "rose",
      "title": "5 Dialer Outcomes",
      "items": [
        "(1) No response \u2192 WA \u2192 retry 24h",
        "(2) Failed (busy/invalid) \u2192 retry 24h",
        "(3) Not interested \u2192 Park/DNC",
        "(4) Interested \u2192 info + query + meeting link \u2192 Booked",
        "(5) Booked \u2192 30m reminder call"
      ]
    }
  ]
